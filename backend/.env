# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=constructiq

# JWT Secrets
JWT_SECRET=super_secret_access_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_54321
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Nodemailer / SMTP Configuration (for verification and password resets)
# Use a mock server configuration like Mailtrap or ethereal for testing
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMTP_FROM="ConstructIQ Support <noreply@constructiq.io>"

# Client Domain (CORS configurations)
CLIENT_URL=http://localhost:5173
